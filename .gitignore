# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# job-applier: generated data + live config (both contain personal info).
# job-applier.config.example.json is the committed template.
/data
/job-applier.config.json

# Bundled Node runtime downloaded by start-mac.command on first run.
/.runtime

# Shareable package built by `npm run package` — a generated artifact, not source.
/job-applier-mac.tar.gz
