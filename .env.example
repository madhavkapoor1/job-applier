# EASIEST WAY: paste keys in the app — Your Profile tab → "API keys" section
# (that writes .env for you, no restart needed). Editing by hand also works:
# copy this file to .env and fill in only the sources you want to enable.
# The keyless boards work with no keys at all.

# Reed.co.uk — UK's biggest job board, great legal coverage (RECOMMENDED).
# Free key: https://www.reed.co.uk/developers  (register, then "Create a new API key")
REED_API_KEY=

# Adzuna — broad UK aggregator. Free: https://developer.adzuna.com/
# (config sources.adzuna.country is set to "gb")
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Google Jobs via SerpAPI (free tier): https://serpapi.com/  (enable in config first)
SERPAPI_KEY=

# Optional: Anthropic (Claude) API key to enable AI-tailored cover letters per job.
# Without it, cover letters use the template (still personalised). Get one at
# https://console.anthropic.com/  (pay-per-use, ~pennies per letter).
ANTHROPIC_API_KEY=

# US-only, off by default — not needed for UK roles.
USAJOBS_API_KEY=
USAJOBS_EMAIL=
